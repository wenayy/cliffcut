<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">
<Content>
<Paragraph Type="Scene Heading"><Text>INT. BOARDROOM - DAY</Text></Paragraph>
<Paragraph Type="Action"><Text>KABIR, the new intern, sets down the coffee. The CEO does not look up.</Text></Paragraph>
<Paragraph Type="Character"><Text>CEO</Text></Paragraph>
<Paragraph Type="Parenthetical"><Text>(cold)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>You spilled it. Clean it up, and then get out of my company.</Text></Paragraph>
<Paragraph Type="Character"><Text>KABIR</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Your company? Read the share register again, sir.</Text></Paragraph>
<Paragraph Type="Action"><Text>The lawyer slides a folder across the table. The CEO goes pale.</Text></Paragraph>
<Paragraph Type="Character"><Text>LAWYER</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>He owns fifty-one percent. As of this morning, he is your boss.</Text></Paragraph>
</Content>
</FinalDraft>
